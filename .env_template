# --- Postgres (pgvector) ---
DB_NAME=newsparser
DB_USER=newsparser
DB_PASSWORD=newsparser
# host: 'postgres' inside docker-compose, 'localhost' for local run
DB_HOST=postgres
# host port for the postgres container (container port is 5432)
DB_PORT=5434

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# host port for the redis container (container port is 6379)
REDIS_PORT_HOST=6380

# --- API ---
API_PORT=8003

# --- LLM (OpenAI-compatible endpoints; local primary + openrouter fallback) ---
LLM_BASE_URL=https://unsloth.home.frants.tech/v1
LLM_API_KEY=
LLM_MODEL=gemma-4-E4B-it-GGUF
# separate embeddings endpoint; empty -> same as LLM_BASE_URL
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-8B-GGUF
# must match the embeddings model dimension AND EMBED_DIM used to init the DB schema
EMBED_DIM=4096

# --- OpenRouter fallback (used when local endpoint fails; empty = disabled) ---
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b

# --- Observability ---
# json = structured logs (prod); empty = human-readable text (dev)
LOG_FORMAT=
# Prometheus metrics port (worker services serve /metrics here)
METRICS_PORT=9100

# --- Dedup ---
# cosine similarity >= threshold -> same event
DEDUP_THRESHOLD=0.75

# --- Queue cap (dev/testing) ---
# max items in redis stream; 0 = unlimited. Set to 0 for production.
QUEUE_MAX_LENGTH=10

# --- Telegram channels (user API, from my.telegram.org) ---
api_id=
api_hash=
# comma-separated channel usernames
TELEGRAM_CHANNELS=interfaxonline,rbc_news,rian_ru,prime1,bcs_express,markettwits,if_market_news,thewallstreetpro,russianmacro,truecon,iticapital
# StringSession for prod (generated by newsparser/tools/tg_login.py or converted
# from newsparser.session); empty -> fall back to the file session volume
TELETHON_SESSION=

# --- Telegram bot (from @BotFather) ---
bot_token=
chat_id=

# --- Parsers ---
POLL_INTERVAL=30

logging_lvl=INFO

# --- Proxy for Telegram (optional) ---
# http proxy reachable from docker containers; empty -> direct connection
TG_PROXY_URL=

# --- Category filter (comma-separated; empty = keep all) ---
# Event whose first tag is not in this list is not created (news item is kept).
ALLOWED_CATEGORIES=

# --- Model keeper (enforce our models on the local LLM server) ---
MODEL_KEEPER=1
MODEL_KEEPER_INTERVAL=60
# unload these if found loaded; empty = never evict (VRAM manager swaps models
# as needed, manual eviction is unnecessary and causes load/unload churn)
MODEL_KEEPER_EVICT=
